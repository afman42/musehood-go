#!/bin/sh
### BEGIN INIT INFO
# Provides:          musehood-go
# Required-Start:    $network $remote_fs
# Required-Stop:     $network $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Musehood Go — obrolan grup multi-AI
### END INIT INFO
# Pasang sebagai /etc/init.d/musehood-go lalu: update-rc.d musehood-go defaults
# (atau chkconfig --add musehood-go di keluarga RHEL lama).

BIN="@BIN@"
USER_NAME="@USER@"
DATA_DIR="@DATA_DIR@"
HOST="@HOST@"
PORT="@PORT@"
PIDFILE="/var/run/musehood-go.pid"
LOGFILE="/var/log/musehood-go.log"

start() {
    echo "Starting musehood-go..."
    mkdir -p "$DATA_DIR"
    chown "$USER_NAME" "$DATA_DIR" 2>/dev/null || true
    touch "$LOGFILE"
    chown "$USER_NAME" "$LOGFILE" 2>/dev/null || true
    if command -v start-stop-daemon >/dev/null 2>&1; then
        start-stop-daemon --start --quiet --background --make-pidfile \
            --pidfile "$PIDFILE" --chuid "$USER_NAME" --chdir "$DATA_DIR" \
            --exec "$BIN" -- -host "$HOST" -port "$PORT" -data-dir "$DATA_DIR" \
            >>"$LOGFILE" 2>&1
    else
        su -s /bin/sh "$USER_NAME" -c "cd '$DATA_DIR' && nohup '$BIN' -host '$HOST' -port '$PORT' -data-dir '$DATA_DIR' >>'$LOGFILE' 2>&1 & echo \$! > '$PIDFILE'"
    fi
    echo "musehood-go started."
}

stop() {
    echo "Stopping musehood-go..."
    if [ -f "$PIDFILE" ]; then
        kill "$(cat "$PIDFILE")" 2>/dev/null || true
        rm -f "$PIDFILE"
    fi
    echo "musehood-go stopped."
}

status() {
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "musehood-go is running (pid $(cat "$PIDFILE"))."
        return 0
    fi
    echo "musehood-go is not running."
    return 3
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart) stop; sleep 1; start ;;
    status) status ;;
    *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
exit 0
